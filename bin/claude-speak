#!/usr/bin/env bash
# Entry point for the Stop hook, the /speak skills and manual use.
# The client is stdlib-only Python; the TTS server is started with uv.
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$root/scripts/claude_speak.py" "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --no-project --python ">=3.10" "$root/scripts/claude_speak.py" "$@"
fi

echo "claude-speak: needs python3 or uv on PATH (https://docs.astral.sh/uv/)"
exit 0
